<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Network Switch app (Android 12+)
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          Preferences are excluded because the toggle configuration is filed per
          subscription id, which the receiving device assigns independently. A restored
          configuration would attach to a different SIM than it was written for.
        -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
