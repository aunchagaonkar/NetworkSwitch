<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Network Switch app
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
      Preferences are excluded because the toggle configuration is filed per
      subscription id, which the receiving device assigns independently. A restored
      configuration would attach to a different SIM than it was written for.
    -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
